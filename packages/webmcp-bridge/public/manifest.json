{
  "manifest_version": 3,
  "name": "WebMCP Bridge",
  "version": "0.0.0",
  "description": "Relays the WebMCP tools a page registers to the local webmcp-bridge.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["activeTab", "scripting", "storage"],
  "optional_host_permissions": ["https://*/*", "http://localhost/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png"
    },
    "default_title": "Expose this tab's WebMCP tools to the bridge"
  }
}
