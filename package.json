{
  "name": "toy-midi",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "vp config",
    "dev": "vite dev --config vite.app.config.ts",
    "build": "pnpm build-wasm && pnpm build-app",
    "build-app": "vite build --config vite.app.config.ts",
    "preview": "vite preview --config vite.app.config.ts",
    "override-wasm": "yq -i '.overrides.\"@hiogawa/bass-pitch-wasm\" = \"workspace:*\"' pnpm-workspace.yaml",
    "build-wasm": "bash tools/build-wasm.sh",
    "typecheck": "tsc -b",
    "lint": "cargo fmt && vp check --fix && pnpm lint-dead-code && pnpm typecheck",
    "lint-check": "cargo fmt -- --check && vp check && pnpm lint-dead-code && pnpm typecheck",
    "lint-dead-code": "fallow dead-code --unused-exports --unused-types",
    "test": "vitest",
    "test-e2e": "playwright test"
  },
  "dependencies": {
    "@hiogawa/bass-pitch-wasm": "https://pkg.pr.new/hi-ogawa/toy-midi/@hiogawa/bass-pitch-wasm@1361732",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-slider": "^1.3.6",
    "@remix-run/fetch-router": "^0.20.1",
    "@remix-run/route-pattern": "^0.23.0",
    "@tanstack/react-query": "^5.90.16",
    "@tonejs/midi": "^2.0.28",
    "cmdk": "^1.1.1",
    "jszip": "^3.10.1",
    "lucide-react": "^0.562.0",
    "opensheetmusicdisplay": "^2.1.1",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "sonner": "^2.0.7",
    "tone": "^15.1.22",
    "zod": "^4.4.3",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^25.0.3",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.1.0",
    "fallow": "^2.50.0",
    "pkg-pr-new": "0.0.75",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.2.2",
    "vite-plus": "^0.1.16",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@11.22.0+sha512.1ff870c4c6133dfd88fb2afc46dd13d47f09c9794b438c6fdb47ca98caf3bc16381ee0be93a091b8e3824cf01f889f46d7d9e20910fb0be1ab0fb5baa80dd621"
}
